# Copie para .env e ajuste. Não commite o .env com valores reais.

# Origens permitidas no CORS, separadas por vírgula (sem barra no final).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL (docker-compose.yml sobe um com estes valores).
DATABASE_URL=postgresql+psycopg://scouter:scouter@localhost:5432/scouter_power

# Modelo de classificação. Caminho relativo à pasta backend/.
MODEL_PATH=data/svm_tuned_model.joblib
MODEL_VERSION=svm_tuned-v1

# Autenticação JWT. Gere um segredo longo e aleatório (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))").
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRA_MINUTOS=60
