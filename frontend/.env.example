# Origem da API, sem /api/v1 e sem barra final (ex.: http://localhost:8000).
#
# Vazio (recomendado em desenvolvimento): o frontend chama /api/v1 na própria origem e o
# proxy do Vite (dev e preview) encaminha /api para http://localhost:8000. Não precisa de CORS.
#
# Preenchido: as chamadas vão direto para essa origem, e o backend precisa liberar a
# origem do frontend em CORS_ORIGINS (ex.: http://localhost:5173,http://localhost:4173).
#
# O valor é embutido no build (vite build). Os testes E2E ignoram este arquivo e
# sempre usam o proxy.
VITE_API_URL=
